@article{liu_number_2025,
	title = {Number, shape, and intervention effects in child {Mandarin} passives},
	issn = {1048-9223, 1532-7817},
	url = {https://www.tandfonline.com/doi/full/10.1080/10489223.2025.2528738},
	doi = {10.1080/10489223.2025.2528738},
	abstract = {Children’s difficulties with long-distance dependencies have been ascribed to intervention effects that arise from moving a noun phrase (NP) argument over another. This study investigates intervention effects in the comprehension of bèi-passives by Mandarin-speaking children. Some syntactic evidence suggests that short bèi-passives do not have a syntactically projected external argument (unlike long bèi-passives) and also cannot be interpreted as adjectival structures (unlike short passives in English). We explore the predictions of the Intervention Hypothesis by comparing children’s performance on short and long passives and by testing whether Number and Shape features modulate these effects in Mandarin long passives. Although both features are encoded on classifiers, neither triggers movement or agreement in Mandarin. Results from our two-choice sentence-picture matching task, conducted with 80 Mandarin-speaking children aged 3 to 6, show that children exhibit significant difficulties comprehending long passives compared to short passives and actives, supporting the Intervention Hypothesis. Moreover, mismatches in Number and Shape do not ameliorate their performance on long passives, suggesting that not all linguistic features are equally relevant in the computation of syntactic dependencies in child grammar across languages. This supports a language-specific grammatical approach to intervention effects, wherein only features that trigger syntactic processes in a given language are represented in the computation of intervention in that language.},
	language = {en},
	urldate = {2025-10-06},
	journal = {Language Acquisition},
	author = {Liu, Minqi and Mateu, Victoria and Hyams, Nina},
	month = oct,
	year = {2025},
	pages = {1--31},
	file = {PDF:/Users/kikil/Zotero/storage/9WGH7QSV/Liu et al. - 2025 - Number, shape, and intervention effects in child Mandarin passives.pdf:application/pdf},
}

